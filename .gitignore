# ─────────────────────────────────────────────────────────
# SENSITIVE DATA & SECRETS (DO NOT COMMIT TO GITHUB)
# ─────────────────────────────────────────────────────────
# App Secrets containing Firebase API keys and DB URLs
lib/core/config/app_secrets.dart
!lib/core/config/app_secrets.dart.example

# Native Firebase Service Files
android/app/google-services.json
!android/app/google-services.json.example
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# Environment variables
*.env
*.env.*
!*.env.example

# Keystores, signing keys & private configs
*.keystore
*.jks
key.properties
local.properties

